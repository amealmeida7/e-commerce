<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title><%= producto.nombre %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

<nav class="navbar navbar-dark bg-danger shadow-sm">
    <div class="container">
        <a class="navbar-brand" href="/">🚀 TechStore</a>
    </div>
</nav>

<div class="container mt-5">
    <div class="card shadow">
        <div class="row">
            <div class="col-md-5 text-center">
                <img src="<%= producto.imagen %>" class="img-fluid p-4">
            </div>
            <div class="col-md-7 p-4">
                <h2><%= producto.nombre %></h2>
                <p><strong>Categoría:</strong> <%= producto.categoria %></p>
                <p class="text-success fs-4">$<%= producto.precio %></p>
                <p><%= producto.descripcion %></p>

                <a href="/" class="btn btn-secondary">Volver</a>
                <a href="/admin/productos/editar/<%= producto._id %>" class="btn btn-primary">Editar</a>
            </div>
        </div>
    </div>
</div>

</body>
</html>
