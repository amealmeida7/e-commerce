<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title><%= producto.nombre %> | TechStore</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container">
        <a class="navbar-brand" href="/">🚀 TechStore</a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="menu">
            <ul class="navbar-nav ms-auto align-items-lg-center">
                <li class="nav-item">
                    <a class="nav-link" href="/categoria/computadores">Computadores</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/categoria/perifericos">Periféricos</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<div class="container mt-5">
    <div class="card shadow-sm border-0">
        <div class="row g-0">
            <div class="col-md-5 text-center bg-light">
                <img src="<%= producto.imagen %>" class="img-fluid p-4">
            </div>

            <div class="col-md-7">
                <div class="card-body">
                    <h2 class="fw-bold"><%= producto.nombre %></h2>
                    <p class="text-muted">Categoría: <strong><%= producto.categoria %></strong></p>
                    <p class="text-success fs-4 fw-bold">$<%= producto.precio %></p>

                    <h5>Descripción</h5>
                    <p class="text-secondary"><%= producto.descripcion %></p>

                    <div class="mt-4">
                        <a href="/" class="btn btn-outline-dark">⬅ Volver</a>
                        <a href="/admin/productos/editar/<%= producto._id %>" class="btn btn-primary fw-semibold ms-2">Editar</a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
