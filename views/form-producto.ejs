<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Producto | TechStore</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container">
        <a class="navbar-brand" href="/">🚀 TechStore</a>
    </div>
</nav>

<div class="container mt-5">
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <h3 class="text-center fw-bold mb-4">
                <%= producto._id ? 'Editar Producto' : 'Nuevo Producto' %>
            </h3>

            <form method="POST" action="<%= producto._id ? '/admin/productos/editar/' + producto._id : '/admin/productos' %>">
                <input type="text" name="nombre" value="<%= producto.nombre || '' %>" class="form-control mb-3" placeholder="Nombre" required>
                <input type="number" name="precio" value="<%= producto.precio || '' %>" class="form-control mb-3" placeholder="Precio" required>
                <input type="text" name="categoria" value="<%= producto.categoria || '' %>" class="form-control mb-3" placeholder="Categoría" required>
                <textarea name="descripcion" class="form-control mb-3" placeholder="Descripción" required><%= producto.descripcion || '' %></textarea>
                <input type="text" name="imagen" value="<%= producto.imagen || '' %>" class="form-control mb-4" placeholder="URL Imagen">

                <div class="d-flex justify-content-between">
                    <a href="/" class="btn btn-outline-dark">Cancelar</a>
                    <button class="btn btn-primary fw-semibold">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
